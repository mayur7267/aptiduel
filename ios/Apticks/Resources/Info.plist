<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- apticks://c/CODE opens a challenge link in the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.apticks.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>apticks</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Ink</string>
	</dict>
	<!-- From Configs/App.xcconfig. -->
	<key>SupabaseURL</key>
	<string>https://$(SUPABASE_HOST)</string>
	<key>SupabaseKey</key>
	<string>$(SUPABASE_KEY)</string>
</dict>
</plist>
